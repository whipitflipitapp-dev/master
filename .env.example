# Supabase (anon key is safe in the browser; never commit the service role key).
# Recipe cover images upload to Storage bucket `recipe-images` with the anon client after login;
# RLS/storage policies constrain paths — same URL + anon key as the rest of the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase CLI (migrations / db push) -----------------------------------
# Put these in `.env.local` only (gitignored). Next.js does not read SUPABASE_DB_PASSWORD.
#
# • `npx supabase login` — personal access token for the Supabase Management API (link, projects list).
# • `SUPABASE_DB_PASSWORD` — Postgres database password from Dashboard → Project Settings → Database.
#   Used by `supabase link`, `supabase db push`, etc. when the CLI needs a direct DB connection.
#   The CLI reads this env var; it does not load `.env.local` automatically.
#
# Remote project (link once): ref `tpotdxasputlvppvpult` (whipitflipitapp-dev).
#   npx supabase link --project-ref tpotdxasputlvppvpult
# Local link state: `supabase/.temp/` (gitignored). See docs/SUPABASE_CLI.md.
#
# SUPABASE_DB_PASSWORD=your-database-password-from-dashboard

# Service-role key — SERVER ONLY. NEVER expose to the browser. Never prefix with NEXT_PUBLIC_.
# Used server-side only (Stripe webhook, AI wine pairing persistence for demo/system
# recipes) to bypass RLS when the anon client cannot write.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth / magic-link redirect URL must match Supabase Auth URL Configuration.
# Use your deployed origin in production (e.g. https://www.whipitflipit.com).
# Either variable works; set one consistently with Supabase "Site URL" / redirect allow list.
# Required in production for Stripe Checkout success/cancel URLs and Customer Portal return_url.
# Without it, checkout may redirect to localhost and fail in production.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Netlify production ---------------------------------------------------
# Site settings → Environment variables → add all Stripe + Supabase vars below.
# Use test-mode keys/Price IDs until launch; switch Dashboard to Live and redeploy with sk_live_* + live price_* IDs.
# After changing env vars (especially NEXT_PUBLIC_*), trigger Deploy → Trigger deploy so the build picks them up.

# Optional comma-separated extra hostnames allowed for Amazon / Kindle affiliate product URLs
# (defaults cover amazon.* TLDs and amzn.to). Example: a.co,www.amazon.se
# NEXT_PUBLIC_AMAZON_AFFILIATE_HOST_ALLOWLIST=

# --- Stripe (server only) -------------------------------------------------
# Secret API key (sk_test_… in dev, sk_live_… in prod). NEVER expose to the browser.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe Dashboard endpoint for `/api/webhooks/stripe`.
# Enable events: checkout.session.completed, customer.subscription.*, invoice.paid,
# refund.created, charge.refunded (billing_events ledger for admin revenue).
# Use `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally.
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard Price IDs — create one Price per tier+interval (see src/lib/pricing.ts).
# Pro: $3.99/mo, $36/yr. AI Chef: $5.99/mo, $49/yr.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AI_CHEF_MONTHLY=
STRIPE_PRICE_AI_CHEF_YEARLY=

# Optional — starter recipe cover fetch script (`node scripts/fetch-starter-recipe-covers.mjs`).
# Unsplash is only used when TheMealDB and Foodish do not return an image. Create at https://unsplash.com/oauth/applications
# UNSPLASH_ACCESS_KEY=

# OpenAI (server only — never NEXT_PUBLIC_*). AI routes: `src/app/api/ai/*` (Chef + wine pairings)
OPENAI_API_KEY=
# Optional; default `gpt-4o-mini`
# OPENAI_AI_MODEL=
